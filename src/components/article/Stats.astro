---
// Strip of 2–4 figures, each a <Stat>. Cells enter one by one.
interface Props {
  label: string;
  columns?: 2 | 3 | 4;
}
const { label, columns = 4 } = Astro.props;
---
<ul class="stats num" style={`--cols:${columns}`} aria-label={label} data-reveal data-stagger><slot /></ul>

<style>
  .stats {
    list-style: none;
    display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1px;
    margin: 28px 0 16px; padding: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--line);
    border: 1px solid var(--line);
  }
  @media (max-width: 820px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
