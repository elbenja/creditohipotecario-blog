---
// One amount split in two parts (e.g. deductible vs insurer). `part` = first share in %.
import Legend from './Legend.astro';

interface Props {
  part: number;
  first: string;
  second: string;
}
const { part, first, second } = Astro.props;
---
<div class="split">
  <span class="split__bar" aria-hidden="true" style={`--part:${part}%`}><i class="accent"></i><i></i></span>
  <Legend class="split__legend" items={[{ label: first, tone: 'accent' }, { label: second }]} />
</div>

<style>
  .split { margin: 0 0 20px; }
  .split__bar { display: flex; gap: 3px; height: 10px; margin-top: 4px; }
  i { flex: 1 1 0; height: 100%; border-radius: var(--radius-pill); background: var(--text-muted); transform-origin: left; transition: transform 1.1s var(--ease); }
  i:first-child { flex: 0 0 var(--part); }
  i + i { transition-delay: .15s; }
  i.accent { background: var(--accent); }
  .split :global(.split__legend) { margin-top: 12px; }
  :global(.js-reveal) :global([data-reveal]:not([data-in])) i { transform: scaleX(0); }
</style>
