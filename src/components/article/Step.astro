---
// One numbered step inside <Steps>: title + body (default slot, may include <Sources>).
import Panel from './Panel.astro';

interface Props { title: string }
const { title } = Astro.props;
---
<Panel as="li" radius="item" pad="sm" hover="slide" class="step">
  <div>
    <h3 class="step__title">{title}</h3>
    <div class="step__body block-text"><slot /></div>
  </div>
</Panel>

<style>
  :global(.step) {
    counter-increment: step;
    display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 16px;
  }
  :global(.step)::before {
    content: counter(step, decimal-leading-zero);
    font: 800 28px/1.1 var(--font-display);
    letter-spacing: -.03em;
    color: var(--text-faint);
    transition: color var(--dur-3) var(--ease);
  }
  :global(.step:hover)::before { color: var(--text-strong); }
  .step__title { margin: 0 0 6px; font: 600 18px/1.35 var(--font-sans); color: var(--text-heading); }
  @media (max-width: 820px) {
    :global(.step) { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  }
</style>
