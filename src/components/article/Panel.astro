---
// Base surface for every article block: slate-900 fill, 1px line, rounded.
//  radius: 'card' (20px, standalone blocks) | 'item' (16px, list items)
//  pad:    'sm' 24px | 'md' 28px | 'lg' 32px | 'none'   (20px on mobile)
//  hover:  'slide' (→ 4px) | 'lift' (↑ 3px) | none
//  reveal: fade in on scroll; stagger: children enter one by one
interface Props {
  as?: 'div' | 'li' | 'section' | 'figure' | 'ul' | 'ol' | 'aside';
  radius?: 'card' | 'item';
  pad?: 'none' | 'sm' | 'md' | 'lg';
  hover?: 'slide' | 'lift';
  reveal?: boolean;
  stagger?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { as: Tag = 'div', radius = 'card', pad = 'md', hover, reveal = false, stagger = false, class: cls, ...rest } = Astro.props;
---
<Tag
  class:list={['panel', `panel--${radius}`, `panel--pad-${pad}`, hover && `panel--${hover}`, cls]}
  data-reveal={reveal ? '' : undefined}
  data-stagger={stagger ? '' : undefined}
  {...rest}
><slot /></Tag>

<style>
  .panel { background: var(--surface); border: 1px solid var(--line); }
  .panel--card { border-radius: var(--radius-card); }
  .panel--item { border-radius: var(--radius-item); }
  .panel--pad-sm { padding: 24px; }
  .panel--pad-md { padding: 28px; }
  .panel--pad-lg { padding: 32px; }
  .panel--slide, .panel--lift { transition: border-color var(--dur-3) var(--ease), transform var(--dur-3) var(--ease); }
  .panel--slide:hover { border-color: var(--line-strong); transform: translateX(4px); }
  .panel--lift:hover { border-color: var(--line-strong); transform: translateY(-3px); }

  @media (max-width: 820px) {
    .panel--pad-sm, .panel--pad-md, .panel--pad-lg { padding: 20px; }
  }
</style>
