---
// Row of source chips under a paragraph or block. Label switches Fuente/Fuentes by count.
import Icon from '../ui/Icon.astro';
import Label from '../ui/Label.astro';

export interface Source { label: string; href: string }
interface Props {
  items: Source[];
  class?: string;
}
const { items, class: cls } = Astro.props;
---
<p class:list={['sources', cls]}>
  <Label class="sources__label">{items.length === 1 ? 'Fuente' : 'Fuentes'}</Label>
  {items.map((s) => (
    <a class="source" href={s.href} target="_blank" rel="noopener">{s.label}<Icon name="external" size={11} class="source__icon" /></a>
  ))}
</p>

<style>
  :global(.prose) .sources { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: -4px 0 28px; }
  /* Inside blocks the chips sit at the end with their own spacing. */
  :global(.block-text) .sources, :global(.panel) .sources { margin: 16px 0 0; }
  .sources :global(.sources__label) { margin-right: 2px; }
  .source {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 32px; padding: 5px 10px 5px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: 12.5px; line-height: 1.3;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease), background var(--dur-2) var(--ease);
  }
  .source :global(.source__icon) { transition: transform var(--dur-2) var(--ease); }
  .source:hover { color: var(--text-strong); border-color: var(--line-hover); background: var(--surface); }
  .source:hover :global(.source__icon) { transform: translate(2px, -2px); }
</style>
