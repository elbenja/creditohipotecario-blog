---
// One coverage card: icon tile, title, then two labelled columns.
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';
import Label from '../ui/Label.astro';
import Panel from './Panel.astro';

interface Props {
  icon: IconName;
  title: string;
  review: string;
  confirm: string;
  reviewLabel?: string;
  confirmLabel?: string;
}
const { icon, title, review, confirm, reviewLabel = 'Seguro que debes revisar', confirmLabel = 'Qué confirmar' } = Astro.props;
---
<Panel as="li" radius="item" pad="sm" hover="slide" class="cov-item">
  <span class="cov-item__icon" aria-hidden="true"><Icon name={icon} size={20} /></span>
  <div>
    <h3 class="cov-item__title">{title}</h3>
    <dl>
      <div><Label as="dt" class="cov-item__dt">{reviewLabel}</Label><dd class="hi">{review}</dd></div>
      <div><Label as="dt" class="cov-item__dt">{confirmLabel}</Label><dd>{confirm}</dd></div>
    </dl>
  </div>
</Panel>

<style>
  :global(.cov-item) { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 18px; }
  .cov-item__icon {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    border-radius: var(--radius-lg);
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--text-muted);
    transition: color var(--dur-3) var(--ease), border-color var(--dur-3) var(--ease);
  }
  :global(.cov-item:hover) .cov-item__icon { color: var(--text-strong); border-color: var(--line-hover); }
  .cov-item__title { margin: 10px 0 0; font: 600 18px/1.35 var(--font-sans); color: var(--text-heading); }
  dl {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 14px 28px;
    margin: 16px 0 0; padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  dl :global(.cov-item__dt) { display: block; margin-bottom: 6px; }
  dd { margin: 0; font-size: 15.5px; line-height: 1.6; color: var(--text); }
  dd.hi { font-weight: 500; color: var(--text-strong); }

  @media (max-width: 820px) {
    :global(.cov-item) { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .cov-item__title { margin-top: 0; }
    dl { grid-template-columns: minmax(0, 1fr); }
  }
</style>
