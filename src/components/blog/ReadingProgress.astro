---
// Thin bar along the bottom of the nav that tracks how far you've read `target`.
interface Props { target?: string }
const { target = 'articulo' } = Astro.props;
---
<div class="progress" aria-hidden="true"><span data-progress={target}></span></div>

<style>
  .progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; pointer-events: none; }
  span { display: block; height: 100%; background: var(--text-strong); transform: scaleX(0); transform-origin: left; transition: transform .12s linear; }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const art = bar && document.getElementById(bar.dataset.progress!);
  if (bar && art) {
    let raf = 0;
    const track = () => {
      raf = 0;
      const vh = window.innerHeight;
      const r = art.getBoundingClientRect();
      const span = r.height - vh * 0.5;
      const p = span > 0 ? Math.min(1, Math.max(0, (vh * 0.3 - r.top) / span)) : r.top < vh * 0.5 ? 1 : 0;
      bar.style.transform = `scaleX(${p})`;
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(track); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    track();
  }
</script>
