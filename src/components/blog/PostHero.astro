---
// Article header: rounded full-bleed photo with back link, save toggle, meta and title.
import type { Post } from '../../lib/posts';
import { SITE } from '../../config/site';
import GlassButton from '../ui/GlassButton.astro';
import CoverImage from './CoverImage.astro';
import PostMeta from './PostMeta.astro';
import SaveButton from './SaveButton.astro';

interface Props { post: Post }
const { post } = Astro.props;
const { title, category, date, readingTime, cover } = post.data;
---
<header class="hero">
  <CoverImage class="hero__media" src={cover.src} alt={cover.alt} position={cover.position.hero} eager />
  <div class="hero__scrim"></div>
  <div class="hero__top">
    <GlassButton href={SITE.blogPath} icon="back">Blog</GlassButton>
    <SaveButton slug={post.id} title={title} />
  </div>
  <div class="hero__body">
    <PostMeta date={date} readingTime={readingTime} category={category} author={SITE.author} />
    <h1 class="title">{title}</h1>
  </div>
</header>

<style>
  .hero {
    position: relative; isolation: isolate;
    display: flex; flex-direction: column; justify-content: space-between; gap: 120px;
    min-height: 480px;
    padding: 20px;
    border-radius: var(--radius-card-lg);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    animation: rise .7s var(--ease) both;
  }
  .hero :global(.hero__media), .hero__scrim { position: absolute; inset: 0; z-index: -1; }
  .hero :global(.hero__media img) { animation-duration: 1.5s; }
  .hero__scrim {
    background: linear-gradient(180deg,
      rgba(2,6,23,.5) 0%, rgba(2,6,23,0) 26%, rgba(2,6,23,0) 38%,
      rgba(2,6,23,.82) 66%, rgba(2,6,23,.97) 100%);
  }
  .hero__top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .hero__body { display: grid; gap: 18px; padding: 0 28px 24px; max-width: 900px; animation: rise .8s var(--ease) 140ms both; }
  .title {
    margin: 0;
    font: 800 clamp(30px, 4.4vw, 52px)/1.06 var(--font-display);
    letter-spacing: -.035em;
    color: var(--text-heading);
    text-wrap: balance;
  }

  @media (max-width: 820px) {
    .hero { min-height: 420px; gap: 72px; padding: 14px; }
    .hero__body { padding: 0 10px 14px; }
  }
</style>
