---
// "En este artículo" side nav. Highlights the section you're reading.
import type { MarkdownHeading } from 'astro';
import Label from '../ui/Label.astro';

interface Props {
  headings: MarkdownHeading[];
  title?: string;
}
const { headings, title = 'En este artículo' } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---
{items.length > 0 && (
  <nav class="toc" aria-label={title}>
    <Label as="p" class="toc__title">{title}</Label>
    <ol>
      {items.map((h, i) => (
        <li><a class:list={['toc__link', { 'is-active': i === 0 }]} href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc :global(.toc__title) { margin: 0 0 14px; }
  ol { list-style: none; margin: 0; padding: 0; }
  .toc__link {
    display: block;
    padding: 10px 0 10px 16px;
    border-left: 2px solid var(--line);
    color: var(--text-muted);
    font-size: 14px; line-height: 1.4;
    text-decoration: none;
    transition: color var(--dur-2) var(--ease), border-color var(--dur-3) var(--ease), padding var(--dur-3) var(--ease);
  }
  .toc__link:hover { color: var(--text-strong); }
  .toc__link.is-active { color: var(--text-strong); border-left-color: var(--accent); padding-left: 20px; }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const heads = links
    .map((a) => document.getElementById(a.dataset.toc!))
    .filter((h): h is HTMLElement => !!h);

  if (heads.length) {
    let raf = 0;
    const track = () => {
      raf = 0;
      const line = window.innerHeight * 0.35;
      let cur = heads[0].id;
      for (const h of heads) if (h.getBoundingClientRect().top < line) cur = h.id;
      for (const a of links) a.classList.toggle('is-active', a.dataset.toc === cur);
    };
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(track); }, { passive: true });
    for (const a of links) {
      a.addEventListener('click', (e) => {
        const h = document.getElementById(a.dataset.toc!);
        if (!h) return;
        e.preventDefault();
        h.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${h.id}`);
      });
    }
    track();
  }
</script>
