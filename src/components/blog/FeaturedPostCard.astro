---
// Big featured card: full-bleed photo, text on the quiet (right) side, cursor glow.
import type { Post } from '../../lib/posts';
import { postUrl } from '../../lib/posts';
import CardLink from './CardLink.astro';
import CoverImage from './CoverImage.astro';
import PostMeta from './PostMeta.astro';
import ReadMore from './ReadMore.astro';
import SaveButton from './SaveButton.astro';

interface Props {
  post: Post;
  class?: string;
  [key: string]: unknown;
}
const { post, class: cls, ...rest } = Astro.props;
const { title, excerpt, category, date, readingTime, cover } = post.data;
const posVars = [
  cover.position.featured && `--pos:${cover.position.featured}`,
  cover.position.featuredMobile && `--pos-m:${cover.position.featuredMobile}`,
].filter(Boolean).join(';');
---
<article class:list={['card', 'feat', { 'feat--shift': cover.shiftLeft }, cls]} style={posVars || undefined} data-glow {...rest}>
  <CoverImage class="feat__media" src={cover.src} alt={cover.alt} eager />
  <div class="feat__scrim"></div>
  <div class="feat__glow"></div>
  <SaveButton class="feat__save" slug={post.id} title={title} round />
  <div class="body">
    <PostMeta date={date} readingTime={readingTime} category={category} />
    <h2 class="title"><CardLink href={postUrl(post)}>{title}</CardLink></h2>
    <p class="excerpt">{excerpt}</p>
    <ReadMore class="body__more" />
  </div>
</article>

<style>
  .feat {
    position: relative; isolation: isolate;
    display: flex; justify-content: flex-end;
    min-height: 480px;
    border-radius: var(--radius-card-lg);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    animation: rise .8s var(--ease) both;
    transition: transform .32s var(--ease), border-color .32s var(--ease), box-shadow .32s var(--ease);
  }
  .feat:hover, .feat:focus-within { transform: translateY(-3px); border-color: var(--line-strong); box-shadow: 0 24px 60px rgba(0,0,0,.5); }
  .feat:active { transform: scale(.995); }

  .feat :global(.feat__media), .feat__scrim, .feat__glow { position: absolute; inset: 0; z-index: -1; }
  .feat :global(.feat__media img) { object-position: var(--pos, 50% 50%); }
  .feat:hover :global(.feat__media img) { transform: scale(1.045); }
  /* Subject in the centre of the shot: enlarge and push left so it isn't under the text. */
  .feat--shift :global(.feat__media img) { width: 140%; max-width: none; margin-left: -40%; }

  .feat__scrim {
    background:
      linear-gradient(270deg, rgba(2,6,23,.95) 0%, rgba(2,6,23,.92) 40%, rgba(2,6,23,.6) 56%, rgba(2,6,23,0) 76%),
      linear-gradient(0deg, rgba(2,6,23,.4), rgba(2,6,23,0) 42%),
      rgba(2,6,23,.14);
  }
  .feat--shift .feat__scrim {
    background:
      linear-gradient(270deg, rgba(2,6,23,.95) 0%, rgba(2,6,23,.92) 44%, rgba(2,6,23,.5) 52%, rgba(2,6,23,0) 66%),
      linear-gradient(0deg, rgba(2,6,23,.4), rgba(2,6,23,0) 42%),
      rgba(2,6,23,.14);
  }
  .feat__glow {
    background: radial-gradient(460px circle at var(--mx, 70%) var(--my, 30%), rgba(255,255,255,.1), transparent 62%);
    opacity: 0;
    transition: opacity .4s var(--ease);
  }
  .feat:hover .feat__glow { opacity: 1; }
  .feat :global(.feat__save) { position: absolute; top: 20px; right: 20px; z-index: 2; }

  .body { display: flex; flex-direction: column; justify-content: flex-end; gap: 16px; width: min(540px, 48%); padding: 44px; }
  .title {
    margin: 0;
    font: 800 clamp(28px, 3.2vw, 40px)/1.1 var(--font-display);
    letter-spacing: -.03em;
    color: var(--text-heading);
    text-wrap: balance;
  }
  .excerpt { margin: 0; font-size: 17px; line-height: 1.55; color: var(--text-soft); }
  .body :global(.body__more) { margin-top: 8px; }

  @media (max-width: 820px) {
    .feat { flex-direction: column; justify-content: flex-start; min-height: 0; }
    .feat :global(.feat__media) { position: relative; inset: auto; z-index: 0; aspect-ratio: 4 / 3; }
    .feat :global(.feat__media img) { object-position: var(--pos-m, var(--pos, 50% 50%)); }
    .feat--shift :global(.feat__media img) { width: 100%; margin-left: 0; }
    .feat__scrim, .feat__glow { display: none; }
    .body { width: auto; padding: 24px; gap: 12px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-glow]').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${e.clientX - r.left}px`);
      el.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
