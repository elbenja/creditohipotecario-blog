---
// Row card: photo with category on the left, text on the right (stacks on mobile).
// Used in the index list and in "Sigue leyendo".
import type { Post } from '../../lib/posts';
import { postUrl } from '../../lib/posts';
import Badge from '../ui/Badge.astro';
import CardLink from './CardLink.astro';
import CoverImage from './CoverImage.astro';
import PostMeta from './PostMeta.astro';
import ReadMore from './ReadMore.astro';
import SaveButton from './SaveButton.astro';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
  /** Stagger index for the entrance animation. */
  index?: number;
  class?: string;
  [key: string]: unknown;
}
const { post, headingLevel: H = 'h2', index = 0, class: cls, ...rest } = Astro.props;
const { title, excerpt, category, date, readingTime, cover } = post.data;
---
<article class:list={['card', 'row', cls]} style={`--delay:${Math.min(index, 3) * 90 + 60}ms`} {...rest}>
  <div class="thumb">
    <CoverImage class="thumb__media" src={cover.src} alt={cover.alt} position={cover.position.card} />
    <div class="thumb__scrim"></div>
    <Badge class="thumb__badge">{category}</Badge>
    <SaveButton class="thumb__save" slug={post.id} title={title} round />
  </div>
  <div class="body">
    <PostMeta date={date} readingTime={readingTime} tone="muted" />
    <H class="title"><CardLink href={postUrl(post)}>{title}</CardLink></H>
    <p class="excerpt">{excerpt}</p>
    <ReadMore class="body__more" />
  </div>
</article>

<style>
  .row {
    position: relative; isolation: isolate;
    display: grid; grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    animation: rise .8s var(--ease) var(--delay) both;
    transition: transform .32s var(--ease), border-color .32s var(--ease), box-shadow .32s var(--ease);
  }
  .row:hover, .row:focus-within { transform: translateY(-3px); border-color: var(--line-strong); box-shadow: 0 20px 50px rgba(0,0,0,.45); }
  .row:active { transform: scale(.995); }

  .thumb { position: relative; min-height: 260px; overflow: hidden; }
  .thumb :global(.thumb__media) { position: absolute; inset: 0; }
  .row:hover .thumb :global(img) { transform: scale(1.06); }
  .thumb__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(0deg, rgba(2,6,23,.7), rgba(2,6,23,0) 55%),
      linear-gradient(180deg, rgba(2,6,23,.35), rgba(2,6,23,0) 35%),
      rgba(2,6,23,.1);
  }
  .thumb :global(.thumb__badge) { position: absolute; left: 16px; bottom: 16px; }
  .thumb :global(.thumb__save) { position: absolute; top: 14px; right: 14px; z-index: 2; }

  .body { display: flex; flex-direction: column; justify-content: center; gap: 12px; padding: 32px 36px; }
  .title {
    margin: 0;
    font: 700 clamp(22px, 2.4vw, 28px)/1.18 var(--font-display);
    letter-spacing: -.025em;
    color: var(--text-heading);
    text-wrap: balance;
  }
  .excerpt { margin: 0; font-size: 16px; line-height: 1.55; color: var(--text); max-width: 560px; }
  .body :global(.body__more) { margin-top: 6px; }

  @media (max-width: 820px) {
    .row { grid-template-columns: minmax(0, 1fr); }
    .thumb { min-height: 0; aspect-ratio: 16 / 10; }
    .body { padding: 24px; }
  }
</style>
