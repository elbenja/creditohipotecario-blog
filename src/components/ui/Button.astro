---
// Solid / outline button. Renders <a> when href is set, otherwise <button>.
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { IconName } from './icons';

type Props = {
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  icon?: IconName;
  /** Trailing chevron that nudges right on hover. */
  arrow?: boolean;
  block?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'button'>, 'class'> & Omit<HTMLAttributes<'a'>, 'class'>;

const { variant = 'primary', size = 'md', href, icon, arrow, block, class: cls, type = 'button', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, cls]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  {icon && <Icon name={icon} size={16} class="btn__icon" />}
  <slot />
  {arrow && <Icon name="chevron-right" size={16} class="btn__arrow" />}
</Tag>

<style>
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 0 16px;
    border-radius: var(--radius);
    border: 1px solid transparent;
    font: 600 14px var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease),
      color var(--dur-2) var(--ease), box-shadow 200ms ease, transform var(--dur-1) var(--ease);
  }
  .btn:active { transform: scale(.98); }
  .btn--sm { height: 38px; gap: 6px; }
  .btn--md { height: 40px; }
  .btn--lg { height: 48px; font-size: 16px; }
  .btn--block { display: flex; width: 100%; }

  .btn--primary { background: var(--text-strong); color: var(--bg); }
  .btn--primary:hover { background: #fff; box-shadow: 0 8px 24px -8px rgba(255,255,255,.45); }

  .btn--secondary { background: transparent; border-color: var(--line-strong); color: var(--slate-100); }
  .btn--secondary:hover { background: var(--surface); border-color: var(--line-hover); }

  .btn :global(.btn__arrow) { transition: transform 220ms var(--ease); }
  .btn:hover :global(.btn__arrow) { transform: translateX(3px); }
  .btn:global(.is-done) :global(.btn__icon) { animation: pop .32s var(--ease); }
</style>
