---
// Dashed placeholder with icon, title, description and an optional action (default slot).
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  icon: IconName;
  title: string;
  description?: string;
  class?: string;
  [key: string]: unknown;
}
const { icon, title, description, class: cls, ...rest } = Astro.props;
---
<div class:list={['empty', cls]} {...rest}>
  <Icon name={icon} size={28} class="empty__icon" />
  <p class="empty__title">{title}</p>
  {description && <p class="empty__text">{description}</p>}
  <slot />
</div>

<style>
  .empty {
    display: grid; justify-items: center; gap: 10px;
    padding: 72px 24px;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    text-align: center;
    animation: rise .6s var(--ease) both;
  }
  .empty :global(.empty__icon) { color: var(--text-muted); }
  .empty__title { margin: 6px 0 0; font: 700 20px var(--font-display); color: var(--text-heading); }
  .empty__text { margin: 0 0 10px; font-size: 15px; color: var(--text-muted); }
</style>
