---
// Frosted pill control that sits on top of photos (back link, save button).
// Renders <a> when href is set, otherwise <button>.
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { IconName } from './icons';

type Props = {
  href?: string;
  icon?: IconName;
  /** Round 44×44 icon-only button. Needs aria-label. */
  round?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'button'>, 'class'> & Omit<HTMLAttributes<'a'>, 'class'>;

const { href, icon, round, class: cls, type = 'button', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag class:list={['glass', { 'glass--round': round }, cls]} href={href} type={href ? undefined : type} {...rest}>
  {icon && <Icon name={icon} size={16} class="glass__icon" />}
  <slot />
</Tag>

<style>
  .glass {
    position: relative;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 44px;
    padding: 0 16px 0 12px;
    border-radius: var(--radius-pill);
    background: var(--glass-bg);
    border: 1px solid var(--glass-line);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--text-strong);
    font: 600 14px var(--font-sans);
    text-decoration: none;
    transition: background var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease);
  }
  .glass:hover { background: var(--glass-bg-hover); border-color: var(--glass-line-hover); }
  .glass :global(.glass__icon) { transition: transform var(--dur-3) var(--ease); }
  a.glass:hover :global(.glass__icon) { transform: translateX(-3px); }

  .glass--round { width: 44px; padding: 0; }
  .glass--round:hover { transform: scale(1.06); }
  .glass--round:active { transform: scale(.94); }
</style>
